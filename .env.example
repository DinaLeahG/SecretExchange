# Copy to local.env for local testing. On Render, set these under Environment.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_SECRET=paste-the-long-random-secret-you-put-in-apps-script
SITE_URL=https://YOUR-USERNAME.github.io/YOUR-REPO/
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io,http://localhost:8000
# Comma-separated logins allowed to send email from your Gmail. Empty = nobody can send.
APPROVED_SENDERS=you@example.com
PORT=10000
